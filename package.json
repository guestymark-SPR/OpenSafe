{
  "name": "opensafe",
  "productName": "OpenSafe",
  "version": "2.17.0",
  "description": "Free home inventory and asset manager for Windows, with a phone link for adding items from your Android phone.",
  "main": "src/main.js",
  "author": "guestymark-SPR",
  "license": "MIT",
  "homepage": "https://github.com/guestymark-SPR/OpenSafe",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/store.test.js test/security.test.js test/library.test.js test/letterinfo.test.js test/bundle.test.js test/sync.test.js test/redact.test.js test/letter.test.js test/ics-watch.test.js test/marks.test.js test/statement.test.js test/pdfform.test.js",
    "dist:win": "electron-builder --win nsis portable --x64",
    "pack:win-zip": "electron-builder --win zip --x64",
    "release:patch": "npm version patch --no-git-tag-version && git commit -am \"Release v$(node -p \\\"require('./package.json').version\\\")\" && git push",
    "release:minor": "npm version minor --no-git-tag-version && git commit -am \"Release v$(node -p \\\"require('./package.json').version\\\")\" && git push"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "^1.29.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "rtf-stream-parser": "^4.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.guestymark.opensafe",
    "productName": "OpenSafe",
    "copyright": "MIT licence",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/pdfjs-dist/{build,web,types,image_decoders}/**",
      "!node_modules/pdfjs-dist/legacy/{web,image_decoders}/**",
      "!node_modules/pdfjs-dist/**/*.map",
      "!node_modules/pdfjs-dist/legacy/build/{pdf.min.mjs,pdf.worker.min.mjs,pdf.sandbox*.mjs,pdf.renderer*.mjs}"
    ],
    "win": {
      "icon": "build/icon.png",
      "artifactName": "OpenSafe-${version}-${arch}-${name}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "OpenSafe",
      "artifactName": "OpenSafe-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "OpenSafe-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "guestymark-SPR",
        "repo": "OpenSafe",
        "releaseType": "release"
      }
    ],
    "fileAssociations": [
      {
        "ext": "opensafe",
        "name": "OpenSafe export",
        "description": "Items exported from OpenSafe Capture",
        "role": "Editor"
      }
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/bmp-js/**",
      "node_modules/idb-keyval/**",
      "node_modules/is-url/**",
      "node_modules/node-fetch/**",
      "node_modules/whatwg-url/**",
      "node_modules/tr46/**",
      "node_modules/webidl-conversions/**",
      "node_modules/opencollective-postinstall/**",
      "node_modules/regenerator-runtime/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/wasm-feature-detect/**",
      "node_modules/zlibjs/**",
      "node_modules/@tesseract.js-data/**",
      "node_modules/pdfjs-dist/**",
      "node_modules/@napi-rs/**"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guestymark-SPR/OpenSafe.git"
  }
}
